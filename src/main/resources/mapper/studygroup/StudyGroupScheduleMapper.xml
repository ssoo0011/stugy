<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.stugy.studygroup.mapper.StudyGroupScheduleMapper">

    <insert id="insertStudyGroupSchedule" parameterType="com.stugy.studygroup.domain.StudyGroupSchedule"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        <![CDATA[
            INSERT INTO study_group_schedules (
                study_group_id,
                title,
                content,
                scheduled_at,
                created_at
            ) VALUES (
                #{studyGroup.id},
                #{title},
                #{content},
                #{scheduledAt},
                CURRENT_TIMESTAMP
            )
        ]]>
    </insert>

    <update id="updateStudyGroupSchedule" parameterType="com.stugy.studygroup.domain.StudyGroupSchedule">
        <![CDATA[
            UPDATE study_group_schedules
            SET title = #{title},
                content = #{content},
                scheduled_at = #{scheduledAt}
            WHERE id = #{id}
        ]]>
    </update>

    <delete id="deleteById" parameterType="Long">
        <![CDATA[
            DELETE FROM study_group_schedules
            WHERE id = #{id}
        ]]>
    </delete>

    <select id="selectById" parameterType="Long"
            resultType="com.stugy.studygroup.domain.StudyGroupSchedule">
        <![CDATA[
            SELECT
                S.id,
                S.study_group_id AS `studyGroup.id`,
                S.title,
                S.content,
                S.scheduled_at,
                S.created_at
            FROM study_group_schedules S
            WHERE S.id = #{id}
        ]]>
    </select>

    <select id="selectAllByStudyGroupIdOrderByScheduledAtAsc" parameterType="Long"
            resultType="com.stugy.studygroup.domain.StudyGroupSchedule">
        <![CDATA[
            SELECT
                S.id,
                S.study_group_id AS `studyGroup.id`,
                S.title,
                S.content,
                S.scheduled_at,
                S.created_at
            FROM study_group_schedules S
            WHERE S.study_group_id = #{studyGroupId}
            ORDER BY S.scheduled_at ASC
        ]]>
    </select>

</mapper>
